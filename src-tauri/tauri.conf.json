{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Rusty Riffs",
  "version": "0.3.0",
  "identifier": "dev.lyingpasta.rustyriffs",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Rusty Riffs",
        "width": 1280,
        "height": 760,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#11141b"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE5NDdEMEE4MEE3RDM0MzkKUldRNU5IMEtxTkJIcVR2dmR2QisvbE5xa3BOcGo2OXdleUQwVDVXWUwzaHJTR1p1ZmVpRmdVcjgK",
      "endpoints": [
        "https://github.com/lyingpasta/rusty-riffs/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
